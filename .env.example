# Firebase web app (Project settings → Your apps → SDK setup and configuration)
# Guia completo: FIREBASE.md
# Copy this file to `.env` and fill it in. `.env` is gitignored.
# Without these values the app cannot sign anyone in: it shows a setup screen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
